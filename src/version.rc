// Version resource for AITDTweaks.addon64 (see version.h).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     AT_VERSION_MAJOR, AT_VERSION_MINOR, AT_VERSION_PATCH, 0
PRODUCTVERSION  AT_VERSION_MAJOR, AT_VERSION_MINOR, AT_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      AT_PRODUCT
            VALUE "FileDescription",  AT_RC_DESCRIPTION
            VALUE "FileVersion",      AT_VERSION
            VALUE "InternalName",     AT_PRODUCT
            VALUE "LegalCopyright",   "Copyright (c) 2026 Scott Dinwiddie. MIT License."
            VALUE "OriginalFilename", AT_RC_FILENAME
            VALUE "ProductName",      AT_RC_PRODUCT
            VALUE "ProductVersion",   AT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
